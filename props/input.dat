#
# SCF: identical to the relaxation run so the restart density is valid.
# Do NOT change XcType, SpinPolarization, energycutoff or the cell --
# scf.restart would silently read an incompatible density.
#

scf.XcType                   GGA-PBE
scf.SpinPolarization         On
scf.ElectronicTemperature    789.5
scf.energycutoff             200.0
scf.maxIter                  500
scf.EigenvalueSolver         Band
scf.Kgrid                    6 6 1
scf.Mixing.Type              rmm-diisk
scf.Init.Mixing.Weight       0.30
scf.Min.Mixing.Weight        0.001
scf.Max.Mixing.Weight        0.40
scf.Mixing.History           30
scf.Mixing.StartPulay        15
scf.criterion                1.0e-8

# restart from the converged density of the relaxed geometry
scf.restart                  on
scf.fixed.grid              -0.39591458309843    0.37361230957077    7.02571084448970

# single point -- geometry is already relaxed
MD.Type                      NOMD
MD.maxIter                   1

#
# Band dispersion.  Hexagonal 2D path G-M-K-G in fractional reciprocal
# coords of THIS cell.  The 4x4 supercell folds the primitive K onto the
# supercell K (4/3 = 1/3 mod 1), so the MoS2 direct gap still sits at K.
#

Band.dispersion              on
Band.Nkpath                  3
<Band.kpath
  40   0.000000 0.000000 0.000000    0.500000 0.000000 0.000000    g M
  40   0.500000 0.000000 0.000000    0.333333 0.333333 0.000000    M K
  40   0.333333 0.333333 0.000000    0.000000 0.000000 0.000000    K g
Band.kpath>

#
# DOS / PDOS.  Dos.Kgrid is a separate, denser mesh used after the SCF.
# Post-process with:  DosMain test_1.Dos.val test_1.Dos.vec
#

Dos.fileout                  on
Dos.Erange                  -15.0  10.0
Dos.Kgrid                    9 9 1
